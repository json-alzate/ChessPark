{
  "name": "live-stream",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ls",
  "sourceRoot": "apps/live-stream/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/live-stream",
        "browser": "apps/live-stream/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/live-stream/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/live-stream/public"
          },
          {
            "glob": "**/*",
            "input": "apps/chessColate/src/assets/cm-chessboard",
            "output": "assets/cm-chessboard"
          }
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/chessColate/src"]
        },
        "styles": ["apps/live-stream/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "allowedHosts": ["mac-mini-de-jheison.tail23d06b.ts.net"]
      },
      "configurations": {
        "production": {
          "buildTarget": "live-stream:build:production"
        },
        "development": {
          "buildTarget": "live-stream:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "live-stream:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/live-stream/jest.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "live-stream:build",
        "staticFilePath": "dist/apps/live-stream/browser",
        "spa": true
      }
    }
  }
}
