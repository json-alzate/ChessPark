{
  "name": "games-provider",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/games-provider/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/games-provider",
        "main": "libs/games-provider/src/index.ts",
        "tsConfig": "libs/games-provider/tsconfig.lib.json",
        "assets": [
          "libs/games-provider/*.md",
          {
            "glob": "games-index.fallback.json",
            "input": "libs/games-provider/src/lib",
            "output": "src/lib"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/games-provider/jest.config.ts"
      }
    }
  }
}
